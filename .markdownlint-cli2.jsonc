{
  // markdownlint-cli2 config for docs/ + the top-level *.md files (see #238).
  // Run: npx markdownlint-cli2 (uses this file's globs automatically).
  "config": {
    "default": true,
    // Code-heavy pages, tables, and inline `code` regularly exceed 80 chars —
    // wrapping them would hurt readability more than it helps.
    "MD013": false,
    // MkDocs Material's `=== "tab"` admonitions require their content
    // (including fenced code blocks) indented four spaces. A generic
    // CommonMark linter reads that as an "indented code block" competing
    // with the file's other fenced blocks, and flags whichever style is
    // locally in the minority — a false positive in both directions, not a
    // real style regression.
    "MD046": false,
    // Hand-written tables don't follow one pipe-spacing convention, and
    // enforcing one adds no readability for a docs source (only for
    // programmatically generated tables).
    "MD060": false
  },
  "globs": [
    "docs/**/*.md",
    "*.md"
  ],
  "ignores": [
    // Generated by Doxygen + moxygen (docs/gen-api.sh) — regenerated from
    // header comments, not hand-written prose. Its Doxygen-derived structure
    // (many same-named H3s for function overloads, deep members) doesn't fit
    // hand-written-docs lint rules, and any violation would just reappear
    // on the next regeneration. It is gitignored and never committed (#452), so
    // this only bites a local run after `bash docs/gen-api.sh` — keep it.
    "docs/api/**"
  ]
}
